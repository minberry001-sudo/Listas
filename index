
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111318">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Mis listas">
<meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="Organiza tus carpetas y listas desde el móvil.">
<title>Mis listas</title>
<style>
#listApp {
  --bg:#111318;
  --panel:#1d2027;
  --line:#383c45;
  --txt:#f4f4f5;
  --muted:#a5a8b0;
  color:var(--txt);
  background:var(--bg);
  font-family:Arial,sans-serif;
  min-height:100vh;
  padding:16px;
  box-sizing:border-box;
}
#listApp * {box-sizing:border-box}
#listApp button {
  cursor:pointer;
  border:1px solid var(--line);
  background:#292d36;
  color:white;
  padding:10px 14px;
  border-radius:9px;
  font-size:14px;
}
#listApp button.primary {
  background:#4545a5;
  border-color:#6262c9;
}
#listApp button.danger {color:#ff8585}
#listApp .top {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:20px;
}
#listApp h2 {font-size:22px;margin:0}
#listApp .muted {color:var(--muted);font-size:12px}
#listApp .folders {
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(145px,1fr));
  gap:12px;
}
#listApp .folder {
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:12px;
  padding:17px 12px;
  cursor:pointer;
  min-height:105px;
}
#listApp .folder:hover {border-color:#7777d9}
#listApp .folderIcon {font-size:28px}
#listApp .folderName {
  font-weight:bold;
  margin-top:10px;
  overflow-wrap:anywhere;
}
#listApp .listButtons {
  display:grid;
  gap:9px;
}
#listApp .listButton {
  text-align:left;
  width:100%;
  background:var(--panel);
  padding:15px;
}
#listApp .tableWrap {
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:8px;
  margin-top:16px;
}
#listApp table {
  border-collapse:collapse;
  width:100%;
  min-width:0;
  table-layout:fixed;
  font-size:14px;
}
#listApp th {
  background:#353943;
  color:#ddd;
  padding:12px 8px;
  border:1px solid var(--line);
  white-space:normal;
  overflow-wrap:anywhere;
  line-height:1.2;
}
#listApp th:first-child,
#listApp td:first-child {width:34px}
#listApp th:nth-child(2),
#listApp td:nth-child(2) {width:40%}
#listApp td {
  background:#1b1d22;
  border:1px solid var(--line);
  padding:8px;
  text-align:center;
}
#listApp td.nameCell {
  text-align:left;
  min-width:0;
}
#listApp td.nameCell input {text-align:left}
#listApp .rowName {min-width:0}
#listApp td input[type=text],
#listApp td input[type=number] {
  background:transparent;
  color:white;
  border:0;
  outline:none;
  width:100%;
  min-width:0;
  font-size:14px;
  padding:5px 2px;
}
#listApp tr.done td input[type=text],
#listApp tr.done td input[type=number] {
  text-decoration:line-through;
  color:#999;
}
#listApp input[type=checkbox] {
  width:21px;height:21px;cursor:pointer;
}
#listApp .back {margin-bottom:18px}
#listApp .empty {
  padding:30px 10px;
  text-align:center;
  color:var(--muted);
}
#listApp .actions {
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:15px;
}
@media(max-width:500px) {
  #listApp {padding:10px}
  #listApp h2 {font-size:19px}
  #listApp button {padding:9px 11px}
}
@media(max-width:600px) {
  #listApp {
    width:100%;
    min-height:100vh;
    min-height:100svh;
    padding:
      calc(12px + env(safe-area-inset-top))
      12px
      calc(18px + env(safe-area-inset-bottom));
    overflow-x:hidden;
  }
  #listApp .top {align-items:flex-start}
  #listApp .top > div {min-width:0}
  #listApp h2 {overflow-wrap:anywhere}
  #listApp .tableWrap {
    width:100%;
    overflow:hidden;
  }
  #listApp table {width:100%; min-width:0; table-layout:fixed}
  #listApp th {padding:6px 3px; font-size:11px}
  #listApp td {padding:4px 3px}
  #listApp td input[type=text],
  #listApp td input[type=number] {
    width:100%;
    min-width:0;
    padding:4px 1px;
    font-size:13px;
  }
  #listApp .actions button {flex:1 1 auto}
}
</style>
</head>
<body style="margin:0">
<div id="listApp">
<div id="appContent"></div>
<script>
(function(){
  const root=document.getElementById("listApp");
  const content=root.querySelector("#appContent");
  const KEY="miGestorListasV1";
  let data={};
  try {
    data=JSON.parse(localStorage.getItem(KEY))||{folders:[]};
  } catch(e) {
    data={folders:[]};
  }

  let currentFolder=null;
  let currentList=null;

  function save(){
    localStorage.setItem(KEY,JSON.stringify(data));
  }

  function esc(s){
    return String(s??"").replace(/[&<>"']/g,c=>({
      "&":"&amp;","<":"&lt;",">":"&gt;",
      '"':"&quot;","'":"&#39;"
    })[c]);
  }

  function date(){
    return new Date().toLocaleDateString();
  }

  function getFolder(){
    return data.folders.find(f=>f.id===currentFolder);
  }

  function getList(){
    const f=getFolder();
    return f&&f.lists.find(l=>l.id===currentList);
  }

  function id(){
    return Date.now().toString(36)+Math.random().toString(36).slice(2,7);
  }

  function home(){
    currentFolder=null;
    currentList=null;
    content.innerHTML=`
      <div class="top">
        <div>
          <h2>Mis carpetas</h2>
          <div class="muted">Tu espacio de organización</div>
        </div>
        <button class="primary" data-action="new-folder">+ Carpeta</button>
      </div>
      <div class="folders">
        ${data.folders.map(f=>`
          <div class="folder" data-action="open-folder"
            data-id="${esc(f.id)}">
            <div class="folderIcon">📁</div>
            <div class="folderName">${esc(f.name)}</div>
            <div class="muted">${f.lists.length} listas</div>
            <div class="muted">${esc(f.created)}</div>
          </div>
        `).join("")}
      </div>
      ${data.folders.length?"":
        '<div class="empty">Todavía no tienes carpetas.<br>Crea tu primera carpeta.</div>'}
    `;
  }

  function folderPage(){
    const f=getFolder();
    if(!f){home();return;}
    content.innerHTML=`
      <button class="back" data-action="home">← Volver</button>
      <div class="top">
        <div>
          <h2>📁 ${esc(f.name)}</h2>
          <div class="muted">Creada el ${esc(f.created)}</div>
        </div>
        <button class="primary" data-action="new-list">+ Lista</button>
      </div>
      <div class="listButtons">
        ${f.lists.map(l=>`
          <button class="listButton" data-action="open-list"
            data-id="${esc(l.id)}">
            📋 ${esc(l.name)}
            <div class="muted">${l.rows.length} registros · ${esc(l.created)}</div>
          </button>
        `).join("")}
      </div>
      ${f.lists.length?"":
        '<div class="empty">Esta carpeta todavía no tiene listas.</div>'}
      <div class="actions">
        <button data-action="rename-folder">Renombrar carpeta</button>
        <button class="danger" data-action="delete-folder">Eliminar carpeta</button>
      </div>
    `;
  }

  function listPage(){
    const l=getList();
    if(!l){folderPage();return;}
    content.innerHTML=`
      <button class="back" data-action="folder">← Volver a la carpeta</button>
      <div class="top">
        <div>
          <h2>${esc(l.name)}</h2>
          <div class="muted">Creada el ${esc(l.created)}</div>
        </div>
        <button class="primary" data-action="add-row">+ Añadir</button>
      </div>
      <div class="tableWrap">
        <table>
          <thead><tr>
            <th>✓</th>
            <th>Nombre</th>
            ${l.columns.map(c=>`<th>${esc(c)}</th>`).join("")}
          </tr></thead>
          <tbody>
            ${l.rows.map((r,i)=>`
              <tr class="${r.done?'done':''}">
                <td><input type="checkbox" aria-label="Marcar elemento como completado"
                  data-action="check" data-index="${i}" ${r.done?'checked':''}></td>
                <td class="nameCell">
                  <input class="rowName" type="text" aria-label="Nombre"
                    value="${esc(r.name)}" data-action="edit-name" data-index="${i}">
                </td>
                ${l.columns.map((c,j)=>`
                  <td data-label="${esc(c)}"><input type="number" step="any" aria-label="${esc(c)}"
                    value="${esc(r.values[j]??'')}"
                    data-action="edit-value"
                    data-index="${i}" data-col="${j}"></td>
                `).join("")}
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
      <div class="muted" style="margin-top:10px">
        ${l.rows.length} registros · ${l.columns.length} columnas numéricas
      </div>
      <div class="actions">
        <button data-action="add-row">+ Añadir fila</button>
        <button data-action="rename-list">Renombrar lista</button>
        <button class="danger" data-action="delete-list">Eliminar lista</button>
      </div>
    `;
  }

  function newFolder(){
    const name=prompt("Nombre de la carpeta:");
    if(!name||!name.trim())return;
    data.folders.push({
      id:id(),name:name.trim(),created:date(),lists:[]
    });
    save();home();
  }

  function newList(){
    const name=prompt("Nombre de la lista:");
    if(!name||!name.trim())return;
    const amount=Number(prompt(
      "¿Cuántas columnas numéricas quieres?","2"
    ));
    if(!Number.isInteger(amount)||amount<1||amount>20){
      alert("Elige entre 1 y 20 columnas.");
      return;
    }
    const columns=[];
    for(let i=0;i<amount;i++){
      const n=prompt("Nombre de la columna "+(i+1)+":",
        "Columna "+(i+1));
      columns.push(n&&n.trim()?n.trim():"Columna "+(i+1));
    }
    getFolder().lists.push({
      id:id(),name:name.trim(),created:date(),
      columns:columns,rows:[]
    });
    save();folderPage();
  }

  function addRow(){
    const l=getList();
    l.rows.push({
      name:"Nuevo elemento",
      values:l.columns.map(()=>""),
      done:false
    });
    save();listPage();
  }

  root.addEventListener("click",function(e){
    const b=e.target.closest("[data-action]");
    if(!b)return;
    const a=b.dataset.action;

    if(a==="new-folder")newFolder();
    if(a==="home")home();
    if(a==="folder")folderPage();
    if(a==="new-list")newList();

    if(a==="open-folder"){
      currentFolder=b.dataset.id;
      folderPage();
    }
    if(a==="open-list"){
      currentList=b.dataset.id;
      listPage();
    }
    if(a==="add-row")addRow();

    if(a==="rename-folder"){
      const f=getFolder();
      const n=prompt("Nuevo nombre:",f.name);
      if(n&&n.trim()){f.name=n.trim();save();folderPage();}
    }
    if(a==="delete-folder"){
      if(confirm("¿Eliminar esta carpeta y todas sus listas?")){
        data.folders=data.folders.filter(
          f=>f.id!==currentFolder
        );
        save();home();
      }
    }
    if(a==="rename-list"){
      const l=getList();
      const n=prompt("Nuevo nombre:",l.name);
      if(n&&n.trim()){l.name=n.trim();save();listPage();}
    }
    if(a==="delete-list"){
      if(confirm("¿Eliminar esta lista?")){
        const f=getFolder();
        f.lists=f.lists.filter(l=>l.id!==currentList);
        save();folderPage();
      }
    }
  });

  root.addEventListener("change",function(e){
    const el=e.target;
    const a=el.dataset.action;
    const l=getList();
    if(!l)return;
    const i=Number(el.dataset.index);
    if(!l.rows[i])return;

    if(a==="check")l.rows[i].done=el.checked;
    if(a==="edit-name")l.rows[i].name=el.value;
    if(a==="edit-value")
      l.rows[i].values[Number(el.dataset.col)]=el.value;

    save();
    if(a==="check")listPage();
  });

  home();
})();
</script>
</div>
</body>
</html>
